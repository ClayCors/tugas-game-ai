        <mxCell id="WIyWlLk6GJQsqaUBKTNV-1" parent="WIyWlLk6GJQsqaUBKTNV-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UML Activity Diagram - Enemy AI Dungeon System\n\nstart\n\n:Baca Posisi Enemy dan Player;\n:Hitung Jarak Euclidean (d = √((x2-x1)² + (y2-y1)²));\n\nif (Jarak &lt;= Radius Deteksi?) then (Ya)\n  :Jalankan Raycast (Bresenham&#39;s Line);\n  \n  if (Pandangan Terhalang Tembok?) then (Ya / LoS Blocked)\n    :Set State = IDLE;\n    :Musuh Diam / Patroli;\n  else (Tidak / LoS Clear)\n    if (Jarak &lt;= Radius Serang?) then (Ya)\n      :Set State = ATTACK;\n      :Serang Player (Deal Damage);\n      stop\n    else (Tidak)\n      :Set State = CHASE;\n      \n      partition \&quot;Sub-Aktivitas: A* Pathfinding\&quot; {\n        :Inisialisasi Open Set (Priority Queue);\n        :Push Start Node (g=0, f=g+h);\n        \n        while (Open Set tidak kosong?) is (Ada Node)\n          :Pop Node dengan f_score Terendah;\n          if (Node == Posisi Player?) then (Tercapai)\n            :Rekonstruksi Rute Jalur;\n            break\n          else (Belum)\n            :Evaluasi Tetangga (4 Arah);\n            :Hitung tentative_g dan f_score;\n            :Update &amp; Masukkan Tetangga Valid ke Open Set;\n          endif\n        endwhile (Kosong / Selesai)\n      }\n      \n      if (Jalur Ditemukan?) then (Ya)\n        :Ambil Langkah Pertama dari Rute;\n        :Pindahkan Posisi Musuh 1 Step;\n      else (Tidak)\n        :Musuh Diam (Jalur Terblokir);\n      endif\n    endif\n  endif\n\nelse (Tidak)\n  :Set State = IDLE;\n  :Musuh Diam / Patroli;\nendif\n\n:Tunggu Frame / Tick Berikutnya;\nstop\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8UaVTV3F871HoPKFqp-b-0">
